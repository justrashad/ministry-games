{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@title/*": ["./src/games/showdown/*"] },
    "types": ["vite/client", "vite-plugin-pwa/react", "vite-plugin-pwa/info"]
  },
  "include": ["src", "server", "netlify", "vite.config.ts", "titles.config.ts"]
}
